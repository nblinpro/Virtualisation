import ldap
from django_auth_ldap.config import LDAPSearch

# Server URI
AUTH_LDAP_SERVER_URI = "ldap://10.0.20.40:389"

# Bind avec l'admin LDAP (compte de service)
AUTH_LDAP_BIND_DN = "cn=admin,dc=infra,dc=lan"
AUTH_LDAP_BIND_PASSWORD = "LdapAdmin2026!"

# Options de connexion
AUTH_LDAP_CONNECTION_OPTIONS = {
    ldap.OPT_REFERRALS: 0,
    ldap.OPT_NETWORK_TIMEOUT: 5,
    ldap.OPT_TIMEOUT: 10,
}

# Recherche utilisateur par uid
AUTH_LDAP_USER_SEARCH = LDAPSearch(
    "ou=people,dc=infra,dc=lan",
    ldap.SCOPE_SUBTREE,
    "(uid=%(user)s)"
)

# Mapping des attributs LDAP -> Django User
AUTH_LDAP_USER_ATTR_MAP = {
    "first_name": "cn",
    "last_name": "sn",
    "email": "mail",
}

# Mode read-only sans groupes
AUTH_LDAP_ALWAYS_UPDATE_USER = True
AUTH_LDAP_CACHE_TIMEOUT = 300

# Logging
import logging
logger = logging.getLogger('django_auth_ldap')
logger.addHandler(logging.StreamHandler())
logger.setLevel(logging.INFO)

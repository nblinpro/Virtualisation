  "templating": {
    "list": [
      {
        "type": "query",
        "name": "node",
        "label": "Nœud PVE",
        "datasource": null,
        "definition": "label_values(pve_up{id=~\"node/.*\"}, instance)",
        "query": "label_values(pve_up{id=~\"node/.*\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": ""
      }
    ]
  },
  "panels": [

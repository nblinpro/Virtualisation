        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": null,
          "expr": "sum by(instance, proxy)(rate(haproxy_frontend_http_requests_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}} / {{proxy}}",
          "refId": "A",
          "range": true

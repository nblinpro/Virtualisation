# =============================================================================
# Samba configuration - Generated by Ansible
# NAS Ynov - VLAN 99 BACKUP
# =============================================================================

[global]
   workgroup = {{ samba_workgroup }}
   server string = {{ samba_server_string }}
   netbios name = {{ samba_netbios_name }}

   # Authentification
   security = user
   map to guest = Bad User
   guest account = nobody

   # Restriction reseau (defense en profondeur)
   hosts allow = {{ samba_allowed_networks | join(' ') }}
   hosts deny = 0.0.0.0/0

   # Performances
   socket options = TCP_NODELAY IPTOS_LOWDELAY
   read raw = yes
   write raw = yes
   use sendfile = yes
   min receivefile size = 16384

   # Pas de NetBIOS broadcast (incompatible LXC unprivileged)
   disable netbios = yes
   smb ports = 445

   # Logs
   log file = /var/log/samba/log.%m
   max log size = 1000
   log level = 1

   # Encodage
   unix charset = UTF-8
   dos charset = CP850

   # Securite (durcissement basique)
   server signing = auto
   client signing = auto
   restrict anonymous = 2
   server min protocol = SMB2_10
   client min protocol = SMB2_10

   # Pas d'impression
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

# =============================================================================
# Shares
# =============================================================================

{% for share in samba_shares %}
[{{ share.name }}]
   comment = {{ share.comment }}
   path = {{ share.path }}
   browsable = {{ share.browsable }}
   writable = {{ share.writable }}
   guest ok = {{ share.guest_ok }}
{% if share.public is defined %}
   public = {{ share.public }}
{% endif %}
{% if share.valid_users is defined %}
   valid users = {{ share.valid_users }}
{% endif %}
{% if share.write_list is defined %}
   write list = {{ share.write_list }}
{% endif %}
{% if share.force_user is defined %}
   force user = {{ share.force_user }}
{% endif %}
{% if share.force_group is defined %}
   force group = {{ share.force_group }}
{% endif %}
{% if share.create_mask is defined %}
   create mask = {{ share.create_mask }}
{% endif %}
{% if share.directory_mask is defined %}
   directory mask = {{ share.directory_mask }}
{% endif %}

{% endfor %}

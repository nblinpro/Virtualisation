; =============================================================================
; Zone forward : {{ bind_zone }}
; Generated by Ansible on {{ ansible_date_time.iso8601 }}
; =============================================================================

$ORIGIN {{ bind_zone }}.
$TTL 3600

@   IN  SOA dns-auth-01.{{ bind_zone }}. admin.{{ bind_zone }}. (
        {{ ansible_date_time.epoch }}  ; serial (timestamp Unix)
        3600        ; refresh (1h)
        1800        ; retry (30min)
        604800      ; expire (1 semaine)
        86400 )     ; minimum TTL (1j)

; Serveurs DNS de la zone
@           IN  NS      dns-auth-01.{{ bind_zone }}.

; Enregistrements A
{% for record in bind_records %}
{{ "%-20s" | format(record.name) }} IN  {{ record.type }}       {{ record.value }}
{% endfor %}

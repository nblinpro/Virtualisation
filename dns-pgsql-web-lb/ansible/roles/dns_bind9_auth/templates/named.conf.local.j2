// =============================================================================
// named.conf.local - Generated by Ansible
// Declaration des zones autoritaires
// =============================================================================

acl allowed_xfer {
{% for ip in bind_allowed_xfer_clients %}
    {{ ip }};
{% endfor %}
};

// -----------------------------------------------------------------------------
// Zone forward : {{ bind_zone }}
// -----------------------------------------------------------------------------
zone "{{ bind_zone }}" {
    type master;
    file "/etc/bind/zones/db.{{ bind_zone }}";
    allow-transfer { allowed_xfer; };
    notify yes;
};

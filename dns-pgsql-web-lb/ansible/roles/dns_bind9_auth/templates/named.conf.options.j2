// =============================================================================
// named.conf.options - Generated by Ansible
// BIND9 en mode AUTORITAIRE uniquement (pas de recursion publique)
// =============================================================================

acl trusted_clients {
{% for net in bind_allowed_query_networks %}
    {{ net }};
{% endfor %}
};

options {
    directory "/var/cache/bind";

    // Interfaces d'ecoute
    listen-on { any; };
    listen-on-v6 { none; };

    // Politique : autoritaire uniquement
    // On NE fait PAS de recursion pour Internet (c'est le job de dns-rec-01)
    recursion no;
    allow-recursion { none; };

    // Autoriser les requetes uniquement depuis les reseaux internes
    allow-query { trusted_clients; };

    // Securite
    version "Not disclosed";
    hostname "Not disclosed";

    // Notify pour les eventuels DNS secondaires
    notify yes;
    also-notify { };

    // DNSSEC
    dnssec-validation no;  // Pas necessaire en autoritaire

    // Logging vers syslog (sera capture par Promtail)
    auth-nxdomain no;
};
